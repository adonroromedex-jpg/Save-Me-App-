{
  "expo": {
    "name": "Save Me",
    "slug": "save-me-secure",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon_white.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon_white.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saveme.secure",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Save Me uses the camera to capture private photos and videos stored securely in the app.",
        "NSFaceIDUsageDescription": "Save Me uses Face ID to protect your private content.",
        "NSPhotoLibraryUsageDescription": "Select your own photos and videos to encrypt in Save Me. Received media is never exported.",
        "NSMicrophoneUsageDescription": "Save Me uses the microphone to record secure voice messages.",
        "NSContactsUsageDescription": "Save Me lets you select a contact to start a private chat."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.saveme.secure",
      "versionCode": 4,
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "minSdkVersion": 24,
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-local-authentication",
      "expo-camera",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Select a contact to start a private Save Me chat."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Save Me to record secure voice messages."
        }
      ],
      "./plugins/withSaveMeCrypto",
      [
        "expo-notifications",
        {
          "color": "#104A91",
          "defaultChannel": "messages",
          "icon": "./assets/notification-icon.png"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
